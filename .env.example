# Backend only. Never prefix credentials with VITE_.
OPENAI_API_KEY=
# Optional offline transcription: install whisper-cli and a multilingual model separately.
# Use absolute local paths; model weights are never bundled or downloaded by Vanta.
TRANSCRIPTION_PROVIDER=
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=
OPENAI_DIRECTOR_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_DIRECTOR_MODEL=
PORT=4317
DATA_DIR=.data
# Optional system Chrome/Chromium. Otherwise Remotion downloads its supported browser.
CHROME_PATH=
