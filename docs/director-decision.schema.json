{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "operations": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "set-clip"
              },
              "clip": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "sourceId": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/clip/properties/id"
                  },
                  "inFrame": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 648000
                  },
                  "outFrame": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/clip/properties/inFrame"
                  },
                  "speed": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 2
                  },
                  "zoom": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 2
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "transition": {
                    "type": "string",
                    "enum": [
                      "cut",
                      "fade-black"
                    ]
                  },
                  "transitionFrames": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 30
                  },
                  "brightness": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 1.5
                  },
                  "contrast": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 1.5
                  },
                  "saturation": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  }
                },
                "required": [
                  "id",
                  "confidence",
                  "reason",
                  "sourceId",
                  "inFrame",
                  "outFrame",
                  "speed",
                  "zoom",
                  "x",
                  "y",
                  "volume",
                  "transition",
                  "transitionFrames",
                  "brightness",
                  "contrast",
                  "saturation"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "clip"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "remove-clip"
              },
              "clipId": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "clipId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "split-clip"
              },
              "clipId": {
                "type": "string"
              },
              "atSourceFrame": {
                "type": "integer"
              },
              "newId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,100}$"
              }
            },
            "required": [
              "type",
              "clipId",
              "atSourceFrame",
              "newId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "set-overlay"
              },
              "overlay": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/clip/properties/id"
                  },
                  "confidence": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/clip/properties/confidence"
                  },
                  "reason": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/clip/properties/reason"
                  },
                  "start": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/clip/properties/inFrame"
                  },
                  "end": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/clip/properties/inFrame"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "title",
                      "lower-third",
                      "image",
                      "broll",
                      "stat",
                      "motion"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "sourceId": {
                    "anyOf": [
                      {
                        "$ref": "#/properties/operations/items/anyOf/0/properties/clip/properties/id"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "scale": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 1
                  },
                  "motion": {
                    "type": "object",
                    "properties": {
                      "preset": {
                        "type": "string",
                        "enum": [
                          "kinetic-title",
                          "callout",
                          "stat-counter"
                        ]
                      },
                      "enterFrames": {
                        "type": "integer",
                        "minimum": 3,
                        "maximum": 30
                      },
                      "exitFrames": {
                        "type": "integer",
                        "minimum": 3,
                        "maximum": 30
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1000000
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "suffix": {
                        "type": "string",
                        "maxLength": 12
                      }
                    },
                    "required": [
                      "preset",
                      "enterFrames",
                      "exitFrames",
                      "value",
                      "suffix"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "confidence",
                  "reason",
                  "start",
                  "end",
                  "type",
                  "text",
                  "sourceId",
                  "x",
                  "y",
                  "scale"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "overlay"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "remove-overlay"
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "set-audio"
              },
              "audio": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/clip/properties/id"
                  },
                  "confidence": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/clip/properties/confidence"
                  },
                  "reason": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/clip/properties/reason"
                  },
                  "sourceId": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/clip/properties/id"
                  },
                  "start": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/clip/properties/inFrame"
                  },
                  "end": {
                    "$ref": "#/properties/operations/items/anyOf/0/properties/clip/properties/inFrame"
                  },
                  "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "ducking": {
                    "type": "boolean"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "music",
                      "sfx"
                    ]
                  }
                },
                "required": [
                  "id",
                  "confidence",
                  "reason",
                  "sourceId",
                  "start",
                  "end",
                  "volume",
                  "ducking",
                  "role"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "audio"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "remove-audio"
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "set-aspect"
              },
              "aspect": {
                "type": "string",
                "enum": [
                  "16:9",
                  "9:16"
                ]
              }
            },
            "required": [
              "type",
              "aspect"
            ],
            "additionalProperties": false
          }
        ]
      },
      "maxItems": 100
    }
  },
  "required": [
    "summary",
    "operations"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
