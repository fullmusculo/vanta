{
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "fps": {
      "type": "number",
      "const": 30
    },
    "aspect": {
      "type": "string",
      "enum": [
        "16:9",
        "9:16"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "video",
              "audio",
              "image"
            ]
          },
          "durationSeconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 7200
          }
        },
        "required": [
          "id",
          "kind",
          "durationSeconds"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 50
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/properties/sources/items/properties/id"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "sourceId": {
            "$ref": "#/properties/sources/items/properties/id"
          },
          "inFrame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 648000
          },
          "outFrame": {
            "$ref": "#/properties/clips/items/properties/inFrame"
          },
          "speed": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 2
          },
          "zoom": {
            "type": "number",
            "minimum": 1,
            "maximum": 2
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "transition": {
            "type": "string",
            "enum": [
              "cut",
              "fade-black"
            ]
          },
          "transitionFrames": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30
          },
          "brightness": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1.5
          },
          "contrast": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1.5
          },
          "saturation": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          }
        },
        "required": [
          "id",
          "confidence",
          "reason",
          "sourceId",
          "inFrame",
          "outFrame",
          "speed",
          "zoom",
          "x",
          "y",
          "volume",
          "transition",
          "transitionFrames",
          "brightness",
          "contrast",
          "saturation"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 500
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/properties/sources/items/properties/id"
          },
          "confidence": {
            "$ref": "#/properties/clips/items/properties/confidence"
          },
          "reason": {
            "$ref": "#/properties/clips/items/properties/reason"
          },
          "sourceId": {
            "$ref": "#/properties/sources/items/properties/id"
          },
          "inFrame": {
            "$ref": "#/properties/clips/items/properties/inFrame"
          },
          "outFrame": {
            "$ref": "#/properties/clips/items/properties/inFrame"
          }
        },
        "required": [
          "id",
          "confidence",
          "reason",
          "sourceId",
          "inFrame",
          "outFrame"
        ],
        "additionalProperties": false
      },
      "maxItems": 500
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/properties/sources/items/properties/id"
          },
          "confidence": {
            "$ref": "#/properties/clips/items/properties/confidence"
          },
          "reason": {
            "$ref": "#/properties/clips/items/properties/reason"
          },
          "start": {
            "$ref": "#/properties/clips/items/properties/inFrame"
          },
          "end": {
            "$ref": "#/properties/clips/items/properties/inFrame"
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "word": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "word",
                "start",
                "end",
                "confidence"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 10
          }
        },
        "required": [
          "id",
          "confidence",
          "reason",
          "start",
          "end",
          "words"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/properties/sources/items/properties/id"
          },
          "confidence": {
            "$ref": "#/properties/clips/items/properties/confidence"
          },
          "reason": {
            "$ref": "#/properties/clips/items/properties/reason"
          },
          "start": {
            "$ref": "#/properties/clips/items/properties/inFrame"
          },
          "end": {
            "$ref": "#/properties/clips/items/properties/inFrame"
          },
          "type": {
            "type": "string",
            "enum": [
              "title",
              "lower-third",
              "image",
              "broll",
              "stat"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 300
          },
          "sourceId": {
            "anyOf": [
              {
                "$ref": "#/properties/sources/items/properties/id"
              },
              {
                "type": "null"
              }
            ]
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "scale": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "confidence",
          "reason",
          "start",
          "end",
          "type",
          "text",
          "sourceId",
          "x",
          "y",
          "scale"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/properties/sources/items/properties/id"
          },
          "confidence": {
            "$ref": "#/properties/clips/items/properties/confidence"
          },
          "reason": {
            "$ref": "#/properties/clips/items/properties/reason"
          },
          "sourceId": {
            "$ref": "#/properties/sources/items/properties/id"
          },
          "start": {
            "$ref": "#/properties/clips/items/properties/inFrame"
          },
          "end": {
            "$ref": "#/properties/clips/items/properties/inFrame"
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "ducking": {
            "type": "boolean"
          },
          "role": {
            "type": "string",
            "enum": [
              "music",
              "sfx"
            ]
          }
        },
        "required": [
          "id",
          "confidence",
          "reason",
          "sourceId",
          "start",
          "end",
          "volume",
          "ducking",
          "role"
        ],
        "additionalProperties": false
      },
      "maxItems": 30
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "brandVerified": {
          "type": "boolean"
        },
        "cutPaceSeconds": {
          "type": "number",
          "minimum": 2,
          "maximum": 60
        },
        "punchInEvery": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "maxSilenceSeconds": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 3
        },
        "visualIntensity": {
          "type": "string",
          "enum": [
            "calm",
            "balanced",
            "dynamic"
          ]
        },
        "fontFamily": {
          "type": "string",
          "enum": [
            "Arial",
            "Verdana",
            "Georgia"
          ]
        },
        "captionColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accentColor": {
          "$ref": "#/properties/profile/properties/captionColor"
        },
        "safeArea": {
          "type": "number",
          "minimum": 0.08,
          "maximum": 0.25
        },
        "captionWords": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "transition": {
          "type": "string",
          "enum": [
            "cut",
            "fade-black"
          ]
        },
        "musicVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3
        },
        "broll": {
          "type": "string",
          "enum": [
            "off",
            "manual"
          ]
        },
        "logoAssetId": {
          "anyOf": [
            {
              "$ref": "#/properties/sources/items/properties/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "label",
        "brandVerified",
        "cutPaceSeconds",
        "punchInEvery",
        "maxSilenceSeconds",
        "visualIntensity",
        "fontFamily",
        "captionColor",
        "accentColor",
        "safeArea",
        "captionWords",
        "transition",
        "musicVolume",
        "broll",
        "logoAssetId"
      ],
      "additionalProperties": false
    },
    "render": {
      "type": "object",
      "properties": {
        "codec": {
          "type": "string",
          "const": "h264"
        },
        "quality": {
          "type": "string",
          "enum": [
            "draft",
            "final"
          ]
        }
      },
      "required": [
        "codec",
        "quality"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "fps",
    "aspect",
    "sources",
    "clips",
    "removed",
    "captions",
    "overlays",
    "audio",
    "profile",
    "render"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
