{
  "name": "vanta",
  "version": "2.1.0",
  "description": "Agentic video editor derived from Vanta: validated editorial plans, reviewable timelines and deterministic rendering.",
  "scripts": {
    "start": "npx remotion studio",
    "build": "npx remotion render src/index.ts VantaShowcase out/vanta-showcase.mp4",
    "render": "npx remotion render src/index.ts VantaShowcase out/vanta-showcase.mp4",
    "render:gif": "npx remotion render src/index.ts VantaShowcase out/vanta-showcase.gif --image-format png",
    "preview": "npx remotion preview src/index.ts",
    "upgrade": "npx remotion upgrade",
    "editor:build": "tsc -p tsconfig.editor.json && vite build web --outDir ../web-dist",
    "editor:api": "node --env-file-if-exists=.env --import tsx server/api.ts",
    "editor:worker": "node --env-file-if-exists=.env --import tsx server/worker.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.editor.json",
    "test:smoke": "node scripts/make-fixtures.mjs && node scripts/run-smoke.mjs",
    "schema:export": "node --import tsx scripts/export-schema.ts",
    "test:auto-fixture": "node scripts/make-fixtures.mjs && node scripts/run-auto-fixture.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.527",
    "@remotion/motion-blur": "4.0.527",
    "@remotion/noise": "4.0.527",
    "@remotion/player": "4.0.527",
    "@remotion/renderer": "4.0.527",
    "@remotion/shapes": "4.0.527",
    "@remotion/transitions": "4.0.527",
    "express": "5.2.1",
    "multer": "2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.527",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.1"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.527",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "18.3.7",
    "prettier": "^3.9.9",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vite": "8.3.0"
  },
  "keywords": [
    "remotion",
    "video",
    "programmatic-video",
    "ai-video",
    "ai-video-generator",
    "text-to-video",
    "react",
    "motion-graphics",
    "voice-cloning",
    "text-to-speech",
    "ai-avatars",
    "lip-sync",
    "talking-head",
    "video-editor",
    "video-editing",
    "animated-captions",
    "whisper",
    "subtitles",
    "synthesia-alternative",
    "heygen-alternative",
    "runway-alternative",
    "capcut-alternative",
    "elevenlabs-alternative",
    "open-source-video",
    "vanta"
  ],
  "author": "itsjwill",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fullmusculo/vanta"
  },
  "engines": {
    "node": ">=22.13"
  },
  "type": "module"
}
